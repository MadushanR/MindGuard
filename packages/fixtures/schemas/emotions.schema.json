{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "emotion": {
      "enum": [
        "Calm",
        "Tense",
        "Low",
        "Hopeful"
      ]
    },
    "preferences": {
      "type": "object",
      "properties": {
        "saveHistory": {
          "type": "boolean"
        },
        "retentionDays": {
          "enum": [
            null,
            7,
            30,
            90,
            "manual"
          ]
        },
        "saveVoiceTranscripts": {
          "type": "boolean"
        },
        "reducedMotion": {
          "type": "boolean"
        },
        "largerText": {
          "type": "boolean"
        }
      },
      "required": [
        "saveHistory",
        "retentionDays",
        "saveVoiceTranscripts",
        "reducedMotion",
        "largerText"
      ],
      "additionalProperties": false
    },
    "consent": {
      "type": "object",
      "properties": {
        "voice": {
          "type": "boolean"
        },
        "tone": {
          "type": "boolean"
        },
        "chatObservations": {
          "type": "boolean"
        }
      },
      "required": [
        "voice",
        "tone",
        "chatObservations"
      ],
      "additionalProperties": false
    },
    "estimate": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/emotion"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "label",
        "confidence"
      ],
      "additionalProperties": false
    },
    "reply": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "delayMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 60000
        },
        "failOnce": {
          "type": "boolean"
        },
        "observation": {
          "$ref": "#/$defs/estimate"
        }
      },
      "required": [
        "text",
        "delayMs"
      ],
      "additionalProperties": false
    },
    "chatScript": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "replies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reply"
          }
        },
        "fallback": {
          "$ref": "#/$defs/reply"
        }
      },
      "required": [
        "id",
        "name",
        "replies",
        "fallback"
      ],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "listening",
            "processing",
            "speaking",
            "reconnecting",
            "error",
            "stopped"
          ]
        },
        "durationMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 60000
        },
        "transcript": {
          "type": "object",
          "properties": {
            "user": {
              "type": "string",
              "minLength": 1
            },
            "assistant": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "user",
            "assistant"
          ],
          "additionalProperties": false
        },
        "observation": {
          "$ref": "#/$defs/estimate"
        }
      },
      "required": [
        "state",
        "durationMs"
      ],
      "additionalProperties": false
    },
    "voiceScript": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "name",
        "steps"
      ],
      "additionalProperties": false
    },
    "card": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "emotion": {
          "enum": [
            null,
            "Calm",
            "Tense",
            "Low",
            "Hopeful"
          ]
        },
        "format": {
          "enum": [
            "Videos",
            "Guides"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "duration": {
          "type": "string",
          "minLength": 1
        },
        "artwork": {
          "enum": [
            "meadow",
            "leaves",
            "dunes",
            "steps",
            "dusk",
            "sunrise"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "emotion",
        "format",
        "title",
        "description",
        "duration",
        "artwork",
        "detail"
      ],
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "text",
            "voice"
          ]
        }
      },
      "required": [
        "id",
        "role",
        "text",
        "mode"
      ],
      "additionalProperties": false
    },
    "conversation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "ageDays": {
          "type": "number",
          "minimum": 0
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        }
      },
      "required": [
        "id",
        "title",
        "ageDays",
        "messages"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "conversationId": {
          "type": "string",
          "minLength": 1
        },
        "ageDays": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "enum": [
            "Chat",
            "Voice tone"
          ]
        },
        "predictedLabel": {
          "$ref": "#/$defs/emotion"
        },
        "correctedLabel": {
          "$ref": "#/$defs/emotion"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": [
            "Estimated",
            "Confirmed",
            "Corrected"
          ]
        },
        "dismissed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "ageDays",
        "source",
        "predictedLabel",
        "confidence",
        "status",
        "dismissed"
      ],
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "conversationId": {
          "type": "string",
          "minLength": 1
        },
        "ageDays": {
          "type": "number",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "ageDays",
        "text"
      ],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "chatScriptId": {
          "type": "string",
          "minLength": 1
        },
        "voiceScriptId": {
          "type": "string",
          "minLength": 1
        },
        "initialChatState": {
          "enum": [
            "idle",
            "processing",
            "error"
          ]
        },
        "preferences": {
          "$ref": "#/$defs/preferences"
        },
        "consent": {
          "$ref": "#/$defs/consent"
        },
        "conversationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "memoryIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "chatScriptId",
        "voiceScriptId",
        "initialChatState",
        "preferences",
        "consent",
        "conversationIds",
        "observationIds",
        "memoryIds"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "$schema": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "records"
  ],
  "additionalProperties": false
}
