# Server-only settings. Copy with npm run setup:env, then add the OpenAI key locally.
# Public references below point to the existing MindGuard foundation, not new resources.
PORT=3001
AWS_REGION=ca-central-1
# Host AWS SDK profile. Docker overrides this with its managed refreshable credentials.
# If a different host profile is used, pass -Profile NAME to voice-local.ps1 as well.
AWS_PROFILE=mindguard
# Madushan supplies the project key privately. Leave blank until it is available.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VOICE=marin
COGNITO_ISSUER=https://cognito-idp.ca-central-1.amazonaws.com/ca-central-1_gHPR0XqZa
COGNITO_CLIENT_ID=1h724t9mf6h9jen6v3r6upq2pt
VOICE_TABLE=mindguard-voice-access
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:3001
VOICE_POLICY_FILE=policy.approved.json
# Direct host startup stays unapproved until deliberately enabled for the reviewed policy.
# Local Compose sets the approved policy path/flag explicitly; keep this default false.
VOICE_POLICY_APPROVED=false
MAX_CONCURRENT_SESSIONS=20
DAILY_SESSION_LIMIT=10
SESSION_DURATION_MS=600000
INACTIVITY_MS=90000
