# PUBLIC frontend configuration. Expo loads apps/mobile/.env for local development/builds.
# Never put OpenAI keys, AWS credentials, passwords or tokens in this file.
# This loopback address supports local Expo web and ADB-forwarded Android development.
EXPO_PUBLIC_VOICE_RELAY_URL=http://localhost:3001

# The Docker web image excludes local .env files and uses its same-origin /api/voice proxy.
# Remote deployments require their actual HTTPS endpoint; localhost means this device.
