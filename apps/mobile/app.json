{
  "expo": {
    "scheme": "mindguard",
    "plugins": [
      "expo-router",
      "./plugins/withLocalVoiceNetwork.cjs",
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "MindGuard uses your microphone for your voice conversation with Zen.",
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": ["android.permission.RECORD_AUDIO", "android.permission.MODIFY_AUDIO_SETTINGS"]
        }
      ]
    ],
    "userInterfaceStyle": "light",
    "slug": "mindguard",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mindguard.capstone"
    },
    "name": "MindGuard",
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.mindguard.capstone",
      "softwareKeyboardLayoutMode": "resize"
    },
    "version": "0.1.0",
    "orientation": "portrait",
    "web": {
      "name": "MindGuard",
      "output": "single"
    }
  }
}
