# OPTIONAL: repository verification and Android tooling; no service secrets belong here.
# Copy with npm run setup:env. Plain Node scripts do not load this file automatically.
# Example: node --env-file=.env scripts/verify-live-voice.cjs
MINDGUARD_URL=http://localhost:8080

# Optional installed browser override; otherwise use the script's browser default.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
# Enable only for the synthetic safety test; leave unset for the ordinary voice test.
# VOICE_TEST_SCENARIO=safety

# Optional machine-specific Android settings. Replace paths for your own machine.
# JAVA_HOME=C:/path/to/jdk-17
# ANDROID_HOME=C:/Users/YOUR_USER/AppData/Local/Android/Sdk
# ADB_PATH=C:/Users/YOUR_USER/AppData/Local/Android/Sdk/platform-tools/adb.exe
# ANDROID_SERIAL=emulator-5554
# GRADLE_OPTS=-Dorg.gradle.project.reactNativeArchitectures=x86_64
# Apply to the native runner: node --env-file=.env scripts/android.mjs
# The existing android.local.json override is also supported; see docs/ANDROID-SETUP.md.
